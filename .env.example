# Copy this file to .env.local for non-wallet settings only.
# Never put private keys, seed phrases, or wallet credentials in this file.

# Legacy Testnet signing is reserved for the required BridgeKey wallet flow.
# Do not put a wallet private key here; the deployment CLI refuses Testnet signing.

# Mainnet signing accepts MST_MAINNET_PRIVATE_KEY only from the current process
# environment, entered through a hidden local terminal prompt when authorized.

# Optional only for the Legacy Testnet Etherscan-compatible verifier.
# MST Mainnet uses Hardhat's native Blockscout verifier and needs no API key.
MSTSCAN_API_KEY=

# Optional — enables WalletConnect in the frontend. Get one at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
