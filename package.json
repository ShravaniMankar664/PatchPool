{
  "name": "patchpool",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "npm run --workspace frontend test:e2e",
    "typecheck:deployment": "turbo run typecheck:deployment",
    "compile": "turbo run compile",
    "lint": "turbo run lint",
    "deploy:testnet": "turbo run deploy:testnet",
    "deploy:mainnet": "turbo run deploy:mainnet",
    "preflight:testnet": "turbo run preflight:testnet",
    "preflight:mainnet": "turbo run preflight:mainnet",
    "verify:testnet": "turbo run verify:testnet",
    "verify:mainnet": "turbo run verify:mainnet",
    "finalize:testnet": "turbo run finalize:testnet",
    "finalize:mainnet": "turbo run finalize:mainnet",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.1.3"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "packageManager": "npm@10.9.8"
}
